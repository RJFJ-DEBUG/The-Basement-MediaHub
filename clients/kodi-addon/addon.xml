<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon
  id="plugin.video.basement.mediahub"
  name="The Basement MediaHub"
  version="1.0.0"
  provider-name="RJFJ-DEBUG">

  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
    <import addon="xbmc.gui" version="5.14.0"/>
  </requires>

  <extension
    point="xbmc.python.pluginsource"
    library="default.py">
    <provides>video audio</provides>
  </extension>

  <extension point="xbmc.addon.metadata">
    <platform>all</platform>
    <language>
      <en>
        <summary lang="en">Stream media from The Basement MediaHub</summary>
        <description lang="en">
          Browse and stream Movies, TV Shows, and more from your
          centralized Basement MediaHub API server inside Kodi.
        </description>
        <disclaimer lang="en">
          For personal use only. Requires a running instance of
          The Basement MediaHub media-api.
        </disclaimer>
      </en>
    </language>
    <source>https://github.com/RJFJ-DEBUG/The-Basement-MediaHub</source>
    <news>v1.0.0 - Initial release.</news>
  </extension>

</addon>
